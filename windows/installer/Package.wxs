<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Deginage"
           Manufacturer="Deginage Project"
           Version="$(var.AppVersion)"
           UpgradeCode="7E9A6C41-3B4D-4F2C-9E6A-2A7F8B41D105"
           Language="1041"
           Codepage="932"
           Compressed="yes"
           InstallerVersion="500">

    <SummaryInformation Description="!(loc.PackageDescription)"
                        Comments="!(loc.PackageComments)" />

    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)"
                  AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/tako-kun1/deginage" />

    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicensePath)" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Deginage" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Deginage" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.SourceDir)\**" />
    </ComponentGroup>

    <ComponentGroup Id="AppShortcuts">
      <Component Id="StartMenuShortcuts"
                 Directory="ApplicationProgramsFolder"
                 Guid="B4E2A918-93D4-47F8-B9F5-61C4E9A1E302">
        <Shortcut Id="SettingsStartMenuShortcut"
                  Name="!(loc.ShortcutSettingsName)"
                  Description="!(loc.ShortcutSettingsDesc)"
                  Target="[INSTALLFOLDER]deginage.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <Shortcut Id="SignageStartMenuShortcut"
                  Name="!(loc.ShortcutSignageName)"
                  Description="!(loc.ShortcutSignageDesc)"
                  Target="[INSTALLFOLDER]deginage.exe"
                  Arguments="--signage"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RemoveFolder Id="CleanStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Deginage\Installer"
                       Name="StartMenuShortcuts"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcuts"
                 Directory="DesktopFolder"
                 Guid="3C18D4E7-5A2F-4B9E-8F14-7D21A86E5C09">
        <Shortcut Id="DesktopShortcut"
                  Name="Deginage"
                  Description="!(loc.ShortcutSettingsDesc)"
                  Target="[INSTALLFOLDER]deginage.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon.ico" />
        <RegistryValue Root="HKCU"
                       Key="Software\Deginage\Installer"
                       Name="DesktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainApplication"
             Title="Deginage"
             Description="!(loc.FeatureMainDesc)"
             Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
    </Feature>
  </Package>
</Wix>
